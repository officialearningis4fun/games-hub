<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signUpFragment">

    <fragment
        android:id="@+id/playCardsFragment"
        android:name="com.learningis4fun.gameshub.crusade_cards.play_crusade_cards.presentation.PlayCardsFragment"
        android:label="PlayCardsFragment"
        tools:layout="@layout/fragment_play_cards" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.learningis4fun.gameshub.crusade_cards.feature_profile.presentation.profile.ProfileFragment"
        android:label="ProfileFragment">
        <action
            android:id="@+id/action_profileFragment_to_signUpFragment"
            app:destination="@id/signUpFragment"
            app:popUpTo="@id/cardsStartFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/enterProfileName"
        android:name="com.learningis4fun.gameshub.crusade_cards.feature_profile.presentation.enterProfile.EnterProfileNameFragment"
        android:label="EnterProfileName"
        tools:layout="@layout/fragment_enter_profile_name">
        <action
            android:id="@+id/action_enterProfileName_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/cardsStartFragment"
        android:name="com.learningis4fun.gameshub.crusade_cards.start.CardsStartFragment"
        android:label="CardsStartFragment"
        tools:layout="@layout/fragment_cards_start">
        <action
            android:id="@+id/action_cardsStartFragment_to_playCardsFragment"
            app:destination="@id/playCardsFragment" />
        <action
            android:id="@+id/action_cardsStartFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.learningis4fun.gameshub.signup.SignUpFragment"
        android:label="SignUpFragment"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_cardsStartFragment2"
            app:destination="@id/cardsStartFragment"
            app:popUpTo="@id/signUpFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>