<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GamesHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/orange_500</item>
        <item name="colorPrimaryVariant">@color/orange_700</item>

        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

    </style>

    <!-- Text themes -->

    <style name="Headline5">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Headline6">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Subtitle1">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Subtitle2">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Body1">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Body2">
        <item name="fontFamily">@font/roboto_light</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Caption">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Caption.CardsPlayGroundTitle">
        <item name="android:textColor">@color/white</item>
        <item name="textAllCaps">true</item>
    </style>
</resources>