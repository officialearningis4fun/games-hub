<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <ImageView
        android:id="@+id/img1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:src="@drawable/club_king"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/img5"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/img5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:src="@drawable/diamond_queen"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/img2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/img1" />

    <ImageView
        android:id="@+id/img2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:src="@drawable/joker_red"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/img4"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/img5" />

    <ImageView
        android:id="@+id/img3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:src="@drawable/spade_king"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/img4" />

    <ImageView
        android:id="@+id/img4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minHeight="24dp"
        android:scaleType="matrix"
        android:src="@drawable/club_queen"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/img3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/img2" />

</androidx.constraintlayout.widget.ConstraintLayout>