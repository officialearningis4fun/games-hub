<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.learningis4fun.gameshub.feature_crusade_cards.feature_start.CardsStartFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/games_start_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/orange_500"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:menu="@menu/menu_game_start_fragment"
            app:title="@string/app_name"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_start_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/create_game_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/cloud"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_outline_cloud"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/king"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:rotation="20"
                    android:src="@drawable/heart_king"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@id/cloud"
                    app:layout_constraintTop_toBottomOf="@id/cloud" />

                <ImageView
                    android:id="@+id/joker"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/joker_red"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="@id/cloud"
                    app:layout_constraintStart_toStartOf="@id/cloud"
                    app:layout_constraintTop_toTopOf="@id/king" />

                <ImageView
                    android:id="@+id/queen"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:rotation="-20"
                    android:src="@drawable/diamond_queen"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/cloud"
                    app:layout_constraintTop_toBottomOf="@id/cloud" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/create_game_actions_title"
                    style="@style/Headline5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="Challenge friends or Android to a crusade"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/challenge_ai_btn"
                    app:layout_constraintStart_toStartOf="@id/play_with_friends_btn"
                    app:layout_constraintTop_toBottomOf="@id/joker" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_with_friends_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:text="Friends"
                    app:icon="@drawable/ic_outline_people"
                    app:layout_constraintEnd_toStartOf="@id/guideline2"
                    app:layout_constraintTop_toBottomOf="@id/create_game_actions_title"
                    app:strokeColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/challenge_ai_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:text="Android"
                    app:icon="@drawable/ic_outline_phone_android"
                    app:layout_constraintStart_toEndOf="@id/guideline2"
                    app:layout_constraintTop_toTopOf="@id/play_with_friends_btn"
                    app:strokeColor="@color/white" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/completed_games_more_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/completed_games_title"
                    style="@style/Caption.CardsPlayGroundTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Completed games"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@id/completed_games_title_count"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/completed_games_title_count"
                    style="@style/Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Won 12 of 36"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@id/completed_games_title"
                    app:layout_constraintEnd_toStartOf="@id/completed_games_icon"
                    app:layout_constraintTop_toTopOf="@id/completed_games_title" />

                <ImageView
                    android:id="@+id/completed_games_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:layout_constraintBottom_toBottomOf="@id/completed_games_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/completed_games_title" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/completed_games_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintTop_toBottomOf="@id/completed_games_more_options" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ongoing_games_title"
                style="@style/Caption.CardsPlayGroundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Ongoing games"
                android:textColor="@color/black"
                app:layout_constraintBottom_toTopOf="@id/view_ongoing_game"
                tools:visibility="gone" />

            <include
                android:id="@+id/view_ongoing_game"
                layout="@layout/view_ongoing_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>