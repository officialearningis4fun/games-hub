<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/choose_card_type"
    app:cardCornerRadius="8dp"
    app:cardElevation="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="32dp"
        android:paddingTop="0dp"
        android:paddingEnd="32dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/cards_types_title"
            style="@style/Caption.CardsPlayGroundTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/title_cards_types"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/suit_spade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Spade"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/suit_spade"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/suit_club"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cards_types_title" />

        <ImageButton
            android:id="@+id/suit_club"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Spade"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/suit_club"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/suit_heart"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/suit_spade"
            app:layout_constraintTop_toBottomOf="@id/cards_types_title" />

        <ImageButton
            android:id="@+id/suit_heart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Spade"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/suit_heart"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/suit_diamond"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/suit_club"
            app:layout_constraintTop_toBottomOf="@id/cards_types_title" />

        <ImageButton
            android:id="@+id/suit_diamond"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Spade"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/suit_diamond"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/suit_heart"
            app:layout_constraintTop_toBottomOf="@id/cards_types_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>