<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.learningis4fun.gameshub">

    <uses-feature android:name="android.hardware.screen.portrait" />

    <application
        android:name=".app.GamesHubApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_gameshub_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_gameshub_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GamesHub">
        <activity
            android:name="com.learningis4fun.gameshub.app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="sensorPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

</manifest>